# LinkedIn Activity Tracker: copy to .env (same folder) and fill in.
# These belong to the linkedin-activity-tracker Supabase project ONLY.
# Prefixed with TRACKER_ so they never collide with the Outreach researcher's SUPABASE_* vars.

# Supabase dashboard > Project Settings > API
TRACKER_SUPABASE_URL=your-project-url-here
# service_role key (server-side only, never put in a browser or commit it)
TRACKER_SUPABASE_KEY=your-secret-key-here
