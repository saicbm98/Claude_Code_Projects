# Copy to .streamlit/secrets.toml (same folder) for local runs; it is git-ignored.
# On Streamlit Community Cloud, paste these into the app's Settings > Secrets instead.
# PLACEHOLDERS ONLY. Never commit real values.

# Supabase dashboard > Project Settings > API (linkedin-activity-tracker project)
TRACKER_SUPABASE_URL = "https://your-project-ref.supabase.co"
# New-format secret key (starts with sb_secret_). Server-side only.
TRACKER_SUPABASE_KEY = "sb_secret_your_key_here"

# Password for the app's unlock screen
APP_PASSWORD = "choose-a-long-password"
